# Gateway inside Kubernetes: same routing as deploy/Caddyfile, plain HTTP
# (TLS would be terminated by a cloud load balancer or an Ingress/Gateway).
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@backend path /api/* /health /ready
	handle @backend {
		request_body {
			max_size 12MB
		}
		# "backend" is the Service name: Kubernetes DNS resolves it and
		# load-balances across the ready backend pods
		reverse_proxy backend:8000 {
			flush_interval -1
			header_up X-Request-ID {http.request.uuid}
		}
	}

	handle {
		reverse_proxy frontend:8080
	}

	log {
		output stdout
		format json
	}
}
