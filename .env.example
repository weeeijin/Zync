# Copy to .env (never commit it):  cp .env.example .env
# Generate secrets with:            openssl rand -hex 24
# Use URL-safe characters for POSTGRES_PASSWORD (it is embedded in a URL).

# ── App ──────────────────────────────────────────────────────────────────────
# "production" on the server (enables strict config validation)
APP_ENV=development
ADMIN_SECRET=change-me-to-a-long-random-value
# Comma-separated browser origins allowed to call the API,
# e.g. https://zync.example.com,https://zync-beta.vercel.app
CORS_ORIGINS=http://localhost:5173

# ── Z.ai / GLM API ───────────────────────────────────────────────────────────
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4-flash
ZHIPUAI_API_KEY=your_key_here

# ── Databases ────────────────────────────────────────────────────────────────
NEO4J_PASSWORD=change-me
POSTGRES_USER=zync
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zync
# Local dev only: host port for Postgres (change if 5432 is taken)
POSTGRES_HOST_PORT=5432

# ── Production only ──────────────────────────────────────────────────────────
# Public hostname for automatic HTTPS (empty = plain HTTP on :80)
DOMAIN=
# Public base URL (no trailing slash) — used by Grafana and the external probe
PUBLIC_URL=
# ── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change-me
# Slack incoming webhook (or Discord webhook URL + "/slack"); empty = UI only
ALERT_SLACK_WEBHOOK_URL=
# Image tag to run (set by CI/CD once images are pushed to a registry)
IMAGE_TAG=local
WEB_CONCURRENCY=2
