# Copy to terraform.tfvars (gitignored) and fill in.
aws_region    = "ap-southeast-5" # Malaysia
environment   = "production"
instance_type = "t3.large"

# Public half of the key whose private half is the SERVER_KEY GitHub secret
ssh_public_key = "ssh-ed25519 AAAA... zync-deploy"

# Your IP (curl -s https://checkip.amazonaws.com)/32. GitHub-hosted runners use
# changing IPs — see infra/README.md for the options.
ssh_allowed_cidrs = ["203.0.113.4/32"]

# Optional: DNS + HTTPS via Route 53
domain_name     = ""
route53_zone_id = ""

# Optional: email for infrastructure alarms
alarm_email = ""

backup_retention_days = 30
